# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: `docker compose up -d` starts postgres on localhost:5432 (user/pass: arti)
DATABASE_URL="postgresql://arti:arti@localhost:5432/arti_db?schema=public"

# ── Authentication (NextAuth.js) ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Optional: first admin account, created by `npm run db:seed` ──────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional: admin uploads on Vercel (Vercel Blob) ──────────────────────────
# Without it, uploads are written to the local disk (development only).
BLOB_READ_WRITE_TOKEN=

# ── Optional: transactional email (password reset) via SMTP ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Optional: origins allowed to embed the site in an iframe ────────────────
# Space-separated, e.g. "https://youssef-mdimagh.vercel.app"
ALLOWED_FRAME_ANCESTORS=

# ── Optional: Google Search Console verification token ───────────────────────
GOOGLE_VERIFICATION=
